{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@app/web"],
      "port": 5173
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "@app/server"],
      "env": { "NODE_ENV": "production", "PORT": "3100", "PUBLIC_SITE_URL": "http://localhost:3100" },
      "port": 3100
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    }
  ]
}
