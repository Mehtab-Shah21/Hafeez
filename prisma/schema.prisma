// Dev schema (SQLite). Production uses prisma/postgres/schema.prisma, generated from this file
// by scripts/prisma-postgres.mjs (only the datasource provider changes).
// Portable types only: no native enums or scalar lists. Enum-like columns are String,
// validated by the constants in packages/shared. Localized text lives in `content` Json `{ en, ar }`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model Role {
  id          String @id @default(cuid())
  key         String @unique // SUPER_ADMIN | EDITOR | SEO_MANAGER
  name        String
  permissions Json
  users       User[]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  blogPosts     BlogPost[]
  media         Media[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the raw token; the raw token only lives in the cookie
  familyId  String // all rotations of one login share a family; reuse of a revoked token revokes the family
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String    @default("")

  @@index([userId])
  @@index([familyId])
}

// ---------- Settings & pages ----------

model Setting {
  key       String   @id // company | theme | navbar | footer | hero | seo.global | robots | analytics
  value     Json
  updatedAt DateTime @updatedAt
}

model Page {
  id        String    @id @default(cuid())
  key       String    @unique // home, about, services, ...
  slug      String    @unique
  status    String    @default("PUBLISHED")
  content   Json // { en: { title, intro }, ar: {...} }
  sections  Section[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Section {
  id           String   @id @default(cuid())
  pageId       String
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type         String // hero | stats | process | faq | story | ...
  order        Int      @default(0)
  isVisible    Boolean  @default(true)
  status       String   @default("PUBLISHED")
  content      Json // published { en, ar }
  draftContent Json? // unpublished edits
  updatedAt    DateTime @updatedAt

  @@index([pageId, order])
}

// ---------- Catalogue ----------

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  order     Int      @default(0)
  icon      String   @default("")
  imageId   String?
  image     Media?   @relation("ServiceImage", fields: [imageId], references: [id], onDelete: SetNull)
  featured  Boolean  @default(false)
  status    String   @default("PUBLISHED")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

model EquipmentCategory {
  id        String      @id @default(cuid())
  slug      String      @unique
  order     Int         @default(0)
  content   Json
  equipment Equipment[]
  updatedAt DateTime    @updatedAt
}

model Equipment {
  id               String            @id @default(cuid())
  slug             String            @unique
  categoryId       String
  category         EquipmentCategory @relation(fields: [categoryId], references: [id])
  capacityValue    Float
  capacityUnit     String // t | kg | m (working height)
  withOperator     Boolean           @default(true)
  operatorOptional Boolean           @default(true)
  featured         Boolean           @default(false)
  availability     String            @default("available") // available | limited | on-request
  order            Int               @default(0)
  status           String            @default("PUBLISHED")
  content          Json // { en: { name, summary, description, specs[], rentalTerms[] }, ar }
  images           EquipmentImage[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId, status])
  @@index([featured])
}

model EquipmentImage {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order       Int       @default(0)

  @@index([equipmentId, order])
}

model FleetType {
  id            String   @id @default(cuid())
  slug          String   @unique
  order         Int      @default(0)
  payloadTonnes Float
  deckLengthM   Float
  imageId       String?
  image         Media?   @relation("FleetImage", fields: [imageId], references: [id], onDelete: SetNull)
  status        String   @default("PUBLISHED")
  content       Json
  updatedAt     DateTime @updatedAt
}

// ---------- Trust content ----------

model Client {
  id        String    @id @default(cuid())
  name      String
  logoId    String?
  logo      Media?    @relation("ClientLogo", fields: [logoId], references: [id], onDelete: SetNull)
  url       String    @default("")
  order     Int       @default(0)
  isVisible Boolean   @default(true)
  projects  Project[]
  updatedAt DateTime  @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  avatarId  String?
  avatar    Media?   @relation("TestimonialAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  company   String
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  content   Json // { en: { name, role, quote }, ar }
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  year      Int
  emirate   String
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  coverId   String?
  cover     Media?   @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  gallery   Json // string[] of media ids
  featured  Boolean  @default(false)
  status    String   @default("PUBLISHED")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  photoId   String?
  photo     Media?   @relation("TeamPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  content   Json
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  group     String // general | rental | logistics | courier
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  content   Json // { en: { q, a }, ar }
  updatedAt DateTime @updatedAt

  @@index([group, order])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  coverId     String?
  cover       Media?    @relation("BlogCover", fields: [coverId], references: [id], onDelete: SetNull)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  status      String    @default("DRAFT")
  tags        Json // string[]
  content     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

// ---------- Media ----------

model Media {
  id           String   @id @default(cuid())
  filename     String
  mime         String
  width        Int
  height       Int
  sizeBytes    Int
  variants     Json // { avif: [{w,url}], webp: [{w,url}], original: url }
  alt          Json // { en, ar } (required by the admin)
  folder       String   @default("")
  source       String   @default("upload") // upload | stand-in
  credit       Json? // { author, licence, licenceUrl, sourceUrl } for licensed stand-ins
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  serviceImages      Service[]        @relation("ServiceImage")
  equipmentImages    EquipmentImage[]
  fleetImages        FleetType[]      @relation("FleetImage")
  clientLogos        Client[]         @relation("ClientLogo")
  testimonialAvatars Testimonial[]    @relation("TestimonialAvatar")
  projectCovers      Project[]        @relation("ProjectCover")
  teamPhotos         TeamMember[]     @relation("TeamPhoto")
  blogCovers         BlogPost[]       @relation("BlogCover")
}

// ---------- Inquiries ----------

model Inquiry {
  id            String   @id @default(cuid())
  type          String // quote | contact | booking | courier
  status        String   @default("NEW")
  name          String
  company       String   @default("")
  phone         String
  email         String
  serviceType   String   @default("")
  equipmentSlug String   @default("")
  payload       Json // booking details etc.
  message       String   @default("")
  attachmentId  String?
  notes         Json // [{ at, by, text }]
  locale        String   @default("en")
  ipHash        String   @default("")
  userAgent     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
}

// ---------- SEO ----------

model SeoMeta {
  id             String   @id @default(cuid())
  entityType     String // page | service | equipment | category | project | blog
  entityId       String
  locale         String
  title          String
  description    String
  focusKeyword   String   @default("")
  canonical      String?
  robotsIndex    Boolean  @default(true)
  robotsFollow   Boolean  @default(true)
  ogTitle        String   @default("")
  ogDescription  String   @default("")
  ogImageId      String?
  twitterCard    String   @default("summary_large_image")
  jsonLdOverride Json?
  score          Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([entityType, entityId, locale])
}

model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String   @default("")
  code      Int      @default(301)
  isActive  Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

model NotFoundLog {
  id         String   @id @default(cuid())
  path       String   @unique
  hits       Int      @default(1)
  referrer   String   @default("")
  lastSeenAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // create | update | delete | publish | login | ...
  entityType String
  entityId   String   @default("")
  diff       Json?
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([entityType, createdAt])
}
