# --- Core ---
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database ---
# Dev (SQLite, path relative to prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Prod (PostgreSQL), used with prisma/postgres/schema.prisma:
# DATABASE_URL="postgresql://user:password@localhost:5432/site?schema=public"

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-access
JWT_REFRESH_SECRET=change-me-at-least-32-characters-long-refresh
CSRF_SECRET=change-me-at-least-32-characters-long-csrf
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000

# --- Uploads ---
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Mail ---
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM="Website <no-reply@example.com>"
INQUIRY_NOTIFY_TO=sales@example.com

# --- Optional bot protection ---
TURNSTILE_SECRET=

# --- Seed (dev only; choose your own strong password) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
